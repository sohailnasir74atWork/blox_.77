  "rules": {
    "users": {
      ".indexOn": [
        "displayName",
        "isSelectedReminderEnabled",
        "isReminderEnabled",
        "fcmToken",
        "isModerator",
        "isBabyMod"
      ],
      ".read": true,
      "$userId": {
        ".read": true,
        ".write": "auth != null && auth.uid === $userId && (!newData.exists() || (newData.child('isAdmin').val() === data.child('isAdmin').val() && newData.child('admin').val() === data.child('admin').val() && newData.child('isSeniorMod').val() === data.child('isSeniorMod').val() && newData.child('isModerator').val() === data.child('isModerator').val() && newData.child('isBabyMod').val() === data.child('isBabyMod').val() && newData.child('isTrusted').val() === data.child('isTrusted').val() && newData.child('isGrinder').val() === data.child('isGrinder').val() && newData.child('isRaider').val() === data.child('isRaider').val()))",
        "isAdmin": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'thesolanalabs@gmail.com' || auth.token.email === 'sohailnasir74@gmail.com') && !(root.child('users').child($userId).child('isAdmin').val() === true || root.child('users').child($userId).child('admin').val() === true)"
        },
        "admin": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'thesolanalabs@gmail.com' || auth.token.email === 'sohailnasir74@gmail.com') && !(root.child('users').child($userId).child('isAdmin').val() === true || root.child('users').child($userId).child('admin').val() === true)"
        },
        "isSeniorMod": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'thesolanalabs@gmail.com' || auth.token.email === 'sohailnasir74@gmail.com') && !(root.child('users').child($userId).child('isAdmin').val() === true || root.child('users').child($userId).child('admin').val() === true)"
        },
        "isModerator": {
          ".write": "auth != null && !(root.child('users').child($userId).child('isAdmin').val() === true || root.child('users').child($userId).child('admin').val() === true) && ((root.child('users').child(auth.uid).child('isAdmin').val() === true || root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'thesolanalabs@gmail.com' || auth.token.email === 'sohailnasir74@gmail.com') || (root.child('users').child(auth.uid).child('isSeniorMod').val() === true && root.child('users').child($userId).child('isSeniorMod').val() !== true))"
        },
        "isBabyMod": {
          ".write": "auth != null && !(root.child('users').child($userId).child('isAdmin').val() === true || root.child('users').child($userId).child('admin').val() === true) && ((root.child('users').child(auth.uid).child('isAdmin').val() === true || root.child('users').child(auth.uid).child('admin').val() === true || auth.token.email === 'thesolanalabs@gmail.com' || auth.token.email === 'sohailnasir74@gmail.com') || (root.child('users').child(auth.uid).child('isSeniorMod').val() === true && root.child('users').child($userId).child('isSeniorMod').val() !== true) || (root.child('users').child(auth.uid).child('isModerator').val() === true && root.child('users').child($userId).child('isSeniorMod').val() !== true && root.child('users').child($userId).child('isModerator').val() !== true))"
        },
        "isTrusted": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || root.child('users').child(auth.uid).child('admin').val() === true || root.child('users').child(auth.uid).child('isSeniorMod').val() === true || root.child('users').child(auth.uid).child('isModerator').val() === true || auth.token.email === 'thesolanalabs@gmail.com' || auth.token.email === 'sohailnasir74@gmail.com')"
        },
        "isGrinder": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || root.child('users').child(auth.uid).child('admin').val() === true || root.child('users').child(auth.uid).child('isSeniorMod').val() === true || root.child('users').child(auth.uid).child('isModerator').val() === true || auth.token.email === 'thesolanalabs@gmail.com' || auth.token.email === 'sohailnasir74@gmail.com')"
        },
        "isRaider": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || root.child('users').child(auth.uid).child('admin').val() === true || root.child('users').child(auth.uid).child('isSeniorMod').val() === true || root.child('users').child(auth.uid).child('isModerator').val() === true || auth.token.email === 'thesolanalabs@gmail.com' || auth.token.email === 'sohailnasir74@gmail.com')"
        },
